{
  "manifest_version": 3,
  "name": "Nod LinkedIn helper",
  "version": "0.1.0",
  "description": "Logs the LinkedIn invites you send and shows who accepted, beside the page. It only reads pages you open and talks only to Nod on this computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "downloads"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.linkedin.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open the Nod helper"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["readers.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:*; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
