#!/bin/sh
set -eu

usage() {
  printf '%s\n' 'Usage: career-ops <command> [arguments]' \
    'Commands: doctor, pdf, cv:html, cv:templates, cv:verify-facts, cv:verify-ats, sync-check.' \
    'Files live in /workspace/<this workspace>/shared/career-ops.'
}

here=$(pwd)
case "$here" in
  /workspace/*) ;;
  *)
    echo 'career-ops runs only inside a Nod workspace folder under /workspace.' >&2
    exit 2
    ;;
esac
thread=${here#/workspace/}
thread=${thread%%/*}
case "$thread" in
  '' | *[!A-Za-z0-9_-]*)
    echo "career-ops could not tell the workspace from the folder $here." >&2
    exit 2
    ;;
esac

if [ $# -eq 0 ]; then
  usage
  exit 0
fi
name=$1
shift
case "$name" in
  help | -h | --help)
    usage
    exit 0
    ;;
  doctor) script=doctor ;;
  pdf) script=generate-pdf ;;
  cv:html) script=build-cv-html ;;
  cv:templates) script=cv-templates ;;
  cv:verify-facts) script=verify-cv-facts ;;
  cv:verify-ats) script=verify-ats ;;
  sync-check) script=cv-sync-check ;;
  openai-eval | gemini-eval | openrouter-runner | ollama-eval | batch-evaluate-gemini | openai-tailor)
    echo "career-ops $name calls a model API. Nod never runs it in the workspace; do this step yourself." >&2
    exit 2
    ;;
  *)
    echo "career-ops $name isn't available in Nod's workspace." >&2
    usage >&2
    exit 2
    ;;
esac

export CAREER_OPS_DATA_DIR="/workspace/$thread/shared/career-ops"
unset CAREER_OPS_ROOT CAREER_OPS_PROFILE
mkdir -p "$CAREER_OPS_DATA_DIR"
exec node "/opt/career-ops/$script.mjs" "$@"
