#!/bin/sh
set -eu

usage() {
  printf '%s\n' 'Usage: career-ops <command> [arguments]' \
    'Commands: doctor, pdf, cv:html, cv:templates, cv:verify-facts, cv:verify-ats, sync-check, application, scan, scan:full.' \
    'application takes --url <application page> --pdf output/<file>.pdf and prints the fields career-ops fills from config/profile.yml for a Greenhouse, Ashby or Lever form. It opens nothing and sends nothing.' \
    'scan takes --dry-run, --json, --quiet, --company <name>, --since <days>, --posted-after <date>, --posted-before <date>.' \
    'scan:full takes --dry-run, --json, --verbose, --since <days>, --limit <n>, --ats <greenhouse,lever,ashby>, --include-undated, --shuffle, --resume.' \
    'scan and scan:full also write data/scan-new.tsv: the postings they added in the last 30 days.' \
    'Files live in /workspace/<this workspace>/shared/career-ops.'
}

refuse() {
  echo "$1" >&2
  exit 2
}

listed() {
  word=$1
  shift
  for item in "$@"; do
    [ "$item" = "$word" ] && return 0
  done
  return 1
}

sweeps() {
  case "$1" in
    '' | *[!a-z,]*) refuse "career-ops scan:full --ats takes one or more of greenhouse, lever and ashby, separated by commas." ;;
  esac
  saved=$IFS
  IFS=,
  for item in $1; do
    case "$item" in
      greenhouse | lever | ashby) ;;
      *)
        IFS=$saved
        refuse "career-ops scan:full sweeps only greenhouse, lever and ashby in Nod's workspace, not $item."
        ;;
    esac
  done
  IFS=$saved
}

ats=''
flags() {
  plain=$1
  valued=$2
  shift 2
  while [ $# -gt 0 ]; do
    flag=${1%%=*}
    if listed "$1" $plain; then
      shift
      continue
    fi
    if ! listed "$flag" $valued; then
      case "$flag" in
        --verify | --headed-fallback | --throttle | --rediscover-404 | --liveness)
          refuse "career-ops $name $flag opens posting pages in a browser or through LinkedIn's guest pages, so Nod never runs it. Check a posting with Nod's own browser instead."
          ;;
      esac
      refuse "career-ops $name doesn't take $1 in Nod's workspace. Run career-ops help for the arguments it takes."
    fi
    if [ "$1" = "$flag" ]; then
      [ $# -ge 2 ] || refuse "career-ops $name $1 needs a value."
      value=$2
      shift
    else
      value=${1#*=}
    fi
    case "$value" in
      -*) refuse "career-ops $name $flag needs a value, not $value." ;;
    esac
    if [ "$flag" = --ats ]; then
      sweeps "$value"
      ats=$value
    fi
    shift
  done
}

if [ $# -eq 0 ]; then
  usage
  exit 0
fi
name=$1
shift
case "$name" in
  help | -h | --help)
    usage
    exit 0
    ;;
  doctor) script=doctor ;;
  pdf) script=generate-pdf ;;
  cv:html) script=build-cv-html ;;
  cv:templates) script=cv-templates ;;
  cv:verify-facts) script=verify-cv-facts ;;
  cv:verify-ats) script=verify-ats ;;
  sync-check) script=cv-sync-check ;;
  application)
    script=prepare-application
    flags '' '--url --pdf' "$@"
    ;;
  scan)
    script=scan
    flags '--dry-run --json --quiet' '--company --since --posted-after --posted-before' "$@"
    ;;
  scan:full)
    script=scan-ats-full
    flags '--dry-run --json --verbose --include-undated --shuffle --resume' '--since --limit --ats' "$@"
    [ -n "$ats" ] || set -- "$@" --ats greenhouse,lever,ashby
    ;;
  openai-eval | gemini-eval | openrouter-runner | ollama-eval | batch-evaluate-gemini | openai-tailor | scan:hn)
    refuse "career-ops $name calls a model API. Nod never runs it in the workspace; do this step yourself."
    ;;
  liveness | scan:seek | scan:dayforce | scan:interamt)
    refuse "career-ops $name opens pages in the workspace browser, which Nod uses only for PDFs. Use Nod's own browser instead."
    ;;
  *)
    echo "career-ops $name isn't available in Nod's workspace." >&2
    usage >&2
    exit 2
    ;;
esac

here=$(pwd)
case "$here" in
  /workspace/*) ;;
  *)
    echo 'career-ops runs only inside a Nod workspace folder under /workspace.' >&2
    exit 2
    ;;
esac
thread=${here#/workspace/}
thread=${thread%%/*}
case "$thread" in
  '' | *[!A-Za-z0-9_-]*)
    echo "career-ops could not tell the workspace from the folder $here." >&2
    exit 2
    ;;
esac

for variable in $(env | sed -n 's/^\(CAREER_OPS_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$variable"
done
export CAREER_OPS_DATA_DIR="/workspace/$thread/shared/career-ops"
for file in .env config/plugins.yml; do
  [ ! -e "$CAREER_OPS_DATA_DIR/$file" ] || refuse "career-ops won't run while shared/career-ops/$file exists: it can change which files career-ops reads and which sites it contacts. Nod never writes it; remove it first."
done
mkdir -p "$CAREER_OPS_DATA_DIR"
case "$name" in
  scan | scan:full) ;;
  *) exec node "/opt/career-ops/$script.mjs" "$@" ;;
esac

status=0
node "/opt/career-ops/$script.mjs" "$@" || status=$?
history="$CAREER_OPS_DATA_DIR/data/scan-history.tsv"
if [ -f "$history" ]; then
  since=$(date -u -d '30 days ago' +%F)
  awk -F '\t' -v since="$since" '$6 == "added" && $2 >= since' "$history" >"$CAREER_OPS_DATA_DIR/data/scan-new.tsv"
fi
exit "$status"
