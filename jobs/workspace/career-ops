#!/bin/sh
set -eu

usage() {
  printf '%s\n' 'Usage: career-ops <command> [arguments]' \
    'Commands: doctor, pdf, cv:html, cv:templates, cv:verify-facts, cv:verify-ats, sync-check, scan, scan:full.' \
    'scan takes --dry-run, --json, --quiet, --company <name>, --since <days>, --posted-after <date>, --posted-before <date>.' \
    'scan:full takes --dry-run, --json, --verbose, --since <days>, --limit <n>, --ats <list>, --include-undated, --shuffle, --resume.' \
    'Files live in /workspace/<this workspace>/shared/career-ops.'
}

refuse() {
  echo "$1" >&2
  exit 2
}

flags() {
  plain=$1
  valued=$2
  shift 2
  while [ $# -gt 0 ]; do
    flag=${1%%=*}
    case " $plain $valued " in
      *" $flag "*) ;;
      *)
        case "$flag" in
          --verify | --headed-fallback | --throttle | --rediscover-404 | --liveness)
            refuse "career-ops $name $flag opens posting pages in a browser or through LinkedIn's guest pages, so Nod never runs it. Check a posting with Nod's own browser instead."
            ;;
        esac
        refuse "career-ops $name doesn't take $1 in Nod's workspace. Run career-ops help for the arguments it takes."
        ;;
    esac
    case " $valued " in
      *" $1 "*)
        [ $# -ge 2 ] || refuse "career-ops $name $1 needs a value."
        case "$2" in
          -*) refuse "career-ops $name $1 needs a value, not $2." ;;
        esac
        shift
        ;;
    esac
    shift
  done
}

if [ $# -eq 0 ]; then
  usage
  exit 0
fi
name=$1
shift
case "$name" in
  help | -h | --help)
    usage
    exit 0
    ;;
  doctor) script=doctor ;;
  pdf) script=generate-pdf ;;
  cv:html) script=build-cv-html ;;
  cv:templates) script=cv-templates ;;
  cv:verify-facts) script=verify-cv-facts ;;
  cv:verify-ats) script=verify-ats ;;
  sync-check) script=cv-sync-check ;;
  scan)
    script=scan
    flags '--dry-run --json --quiet' '--company --since --posted-after --posted-before' "$@"
    ;;
  scan:full)
    script=scan-ats-full
    flags '--dry-run --json --verbose --include-undated --shuffle --resume' '--since --limit --ats' "$@"
    ;;
  openai-eval | gemini-eval | openrouter-runner | ollama-eval | batch-evaluate-gemini | openai-tailor | scan:hn)
    refuse "career-ops $name calls a model API. Nod never runs it in the workspace; do this step yourself."
    ;;
  liveness | scan:seek | scan:dayforce | scan:interamt)
    refuse "career-ops $name opens pages in the workspace browser, which Nod uses only for PDFs. Use Nod's own browser instead."
    ;;
  *)
    echo "career-ops $name isn't available in Nod's workspace." >&2
    usage >&2
    exit 2
    ;;
esac

here=$(pwd)
case "$here" in
  /workspace/*) ;;
  *)
    echo 'career-ops runs only inside a Nod workspace folder under /workspace.' >&2
    exit 2
    ;;
esac
thread=${here#/workspace/}
thread=${thread%%/*}
case "$thread" in
  '' | *[!A-Za-z0-9_-]*)
    echo "career-ops could not tell the workspace from the folder $here." >&2
    exit 2
    ;;
esac

for variable in $(env | sed -n 's/^\(CAREER_OPS_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$variable"
done
export CAREER_OPS_DATA_DIR="/workspace/$thread/shared/career-ops"
mkdir -p "$CAREER_OPS_DATA_DIR"
exec node "/opt/career-ops/$script.mjs" "$@"
